# secrets / local deploy config
deploy/.env
deploy/*.local
.env
.env.*
!.env.example

# node
node_modules/
dist/
build/
*.tsbuildinfo
.vite/

# python bytecode (deploy/lib helpers are byte-compiled by CI)
__pycache__/
*.pyc

# data — ANY DATA_DIR inside the checkout (convention: it must start with `data`).
# These directories hold secret.key + config.json (the encrypted Portainer API key and
# the key that decrypts it) — they must never be committed. See docs/DEPLOYMENT.md.
data*/
**/secret.key
*.log

# os / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# deploy build artifacts (context tar, rendered stack file)
deploy/.build/
