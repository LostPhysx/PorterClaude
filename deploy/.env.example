# Copy to deploy/.env (gitignored) and fill in. Used only by deploy/deploy.sh — the app
# image itself is configured through the compose file / the Settings UI.
# PLACEHOLDERS ONLY: never commit a real Portainer API key or password to this file.

# --- required -------------------------------------------------------------------------
PORTAINER_URL=https://portainer.example.com
PORTAINER_API_KEY=paste-your-portainer-api-key-here
PORTAINER_ENDPOINT_ID=2
APP_HOSTNAME=claude.example.com
APP_PASSWORD=change-me
STACK_NAME=porterclaude

# --- optional -------------------------------------------------------------------------
# Image tag built on the remote engine and referenced by the stack (--tag overrides it).
APP_IMAGE=porterclaude:local
# Seconds deploy.sh waits for the app to report {"status":"ok"} (--no-wait skips the poll).
HEALTH_TIMEOUT=180
# Defaults to https://$APP_HOSTNAME/api/health.
HEALTH_URL=https://claude.example.com/api/health
# gid of /var/run/docker.sock on the docker host: `stat -c %g /var/run/docker.sock`.
# The app runs as uid 10001, so socket mode needs it (Portainer mode does not).
DOCKER_GID=999
# External networks nginx-proxy uses; defaults are portainer_dmz / portainer_gate.
PROXY_NETWORK_APP=portainer_dmz
PROXY_NETWORK_EDGE=portainer_gate
# pino log level of the app container.
LOG_LEVEL=info
