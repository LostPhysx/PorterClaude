# Copy to deploy/.env (gitignored) and fill in. Used only by deploy/deploy.sh — the app
# image itself is configured through the compose file / the Settings UI.
# PLACEHOLDERS ONLY: never commit a real Portainer API key or password to this file.
#
# These values describe WHERE deploy.sh builds and deploys PorterClaude. They are not the
# app's own configuration: the docker hosts PorterClaude manages, the coding agents it
# installs on them and the session images are all configured inside the app
# (docs/DEPLOYMENT.md, docs/AGENTS.md). The reference stack only seeds the first host, as
# the local docker socket (PORTERCLAUDE_BACKEND=socket in deploy/docker-compose.yml).

# --- required -------------------------------------------------------------------------
PORTAINER_URL=https://portainer.example.com
PORTAINER_API_KEY=paste-your-portainer-api-key-here
PORTAINER_ENDPOINT_ID=2
APP_HOSTNAME=claude.example.com
APP_PASSWORD=change-me
STACK_NAME=porterclaude

# --- optional -------------------------------------------------------------------------
# Image tag built on the remote engine and referenced by the stack (--tag overrides it).
APP_IMAGE=porterclaude:local
# Seconds deploy.sh waits for the app to report {"status":"ok"} (--no-wait skips the poll).
HEALTH_TIMEOUT=180
# Defaults to https://$APP_HOSTNAME/api/health.
HEALTH_URL=https://claude.example.com/api/health
# gid of /var/run/docker.sock on the docker host: `stat -c %g /var/run/docker.sock`.
# The app runs as uid 10001, so a local-socket host needs it (a Portainer host does not);
# it becomes `group_add:` in the rendered stack. The gid differs per host (999, 989, 992 ...)
# — do NOT keep the example value. Leave it unset and deploy.sh detects it on the engine (a
# throwaway alpine container that bind-mounts the socket read-only and prints `stat -c %g`);
# a --dry-run cannot probe, so it warns and renders the compose fallback 999. Getting it
# wrong is not fatal: the app starts and the socket host reports itself unavailable.
DOCKER_GID=999
# External networks nginx-proxy uses; defaults are portainer_dmz / portainer_gate.
# PROXY_NETWORK_APP is the network the app shares with nginx-proxy, PROXY_NETWORK_EDGE the
# one the proxy itself faces. Both must already exist on the engine (`external: true`).
PROXY_NETWORK_APP=portainer_dmz
PROXY_NETWORK_EDGE=portainer_gate
# Legacy (v0.1) spelling, still accepted: one comma- or space-separated list, first entry =
# app network, second = edge network. It only applies while the two names above are unset.
# PROXY_NETWORKS=portainer_dmz,portainer_gate
# pino log level of the app container.
LOG_LEVEL=info
