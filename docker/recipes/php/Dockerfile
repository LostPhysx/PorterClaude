# PorterClaude recipe: php (php:8.3-fpm-bookworm + nginx + composer + supervisord). OWNER: O1.
# The only recipe that serves traffic: nginx on port 80, document root /workspace/public.
# Everything runs as uid 1000 (`dev`), so every writable path lives under /tmp or /home/dev.
FROM php:8.3-fpm-bookworm
LABEL porterclaude.recipe="php"
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PORTERCLAUDE_RECIPE=php \
    PC_HTTP_PORT=80 \
    COMPOSER_HOME=/home/dev/.composer \
    COMPOSER_ALLOW_SUPERUSER=0 \
    PORTERCLAUDE_PATH_EXTRA=/home/dev/.composer/vendor/bin

COPY common.sh /tmp/common.sh
RUN bash /tmp/common.sh && rm -f /tmp/common.sh

# nginx + supervisor + the libraries the extensions below need
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      nginx \
      supervisor \
      libzip-dev \
      libicu-dev \
 && docker-php-ext-install -j"$(nproc)" pdo_mysql opcache zip intl \
 && rm -rf /var/lib/apt/lists/*

# composer, verified against the published installer signature (arch-neutral)
RUN curl -fsSL https://getcomposer.org/installer -o /tmp/composer-setup.php \
 && curl -fsSL https://composer.github.io/installer.sig -o /tmp/composer-setup.sig \
 && php -r "if (hash_file('sha384', '/tmp/composer-setup.php') === trim(file_get_contents('/tmp/composer-setup.sig'))) { exit(0); } fwrite(STDERR, 'composer installer checksum mismatch'.PHP_EOL); exit(1);" \
 && php /tmp/composer-setup.php --quiet --install-dir=/usr/local/bin --filename=composer \
 && rm -f /tmp/composer-setup.php /tmp/composer-setup.sig \
 && composer --version

# php-fpm pool: foreground, pid + logs outside root-owned paths, loopback socket for nginx
RUN printf '%s\n' \
      '; PorterClaude php recipe - php-fpm overrides (loaded after zz-docker.conf).' \
      '[global]' \
      'daemonize = no' \
      'pid = /tmp/php-fpm.pid' \
      'error_log = /dev/stderr' \
      'log_limit = 8192' \
      '' \
      '[www]' \
      'listen = 127.0.0.1:9000' \
      'clear_env = no' \
      'catch_workers_output = yes' \
      'decorate_workers_output = no' \
      'access.log = /dev/null' \
      'php_admin_flag[log_errors] = on' \
      'php_admin_value[error_log] = /dev/stderr' \
      > /usr/local/etc/php-fpm.d/zz-porterclaude.conf \
 && cp /usr/local/etc/php/php.ini-development /usr/local/etc/php/php.ini

# nginx launcher: honours $PC_HTTP_PORT when binding port 80 as uid 1000 is not allowed
RUN printf '%s\n' \
      '#!/bin/sh' \
      '# PorterClaude php recipe - nginx launcher (generated by docker/recipes/php/Dockerfile).' \
      'set -u' \
      'mkdir -p /tmp/nginx 2>/dev/null || :' \
      'conf=/etc/nginx/nginx.conf' \
      'port="${PC_HTTP_PORT:-80}"' \
      'if [ "$port" != "80" ]; then' \
      '  if sed "s/listen 80;/listen $port;/" /etc/nginx/nginx.conf > /tmp/nginx.conf; then' \
      '    conf=/tmp/nginx.conf' \
      '  else' \
      '    echo "[porterclaude][warn] could not apply PC_HTTP_PORT=$port" >&2' \
      '  fi' \
      'fi' \
      'exec nginx -c "$conf"' \
      > /usr/local/bin/pc-nginx.sh \
 && chmod 0755 /usr/local/bin/pc-nginx.sh

COPY nginx.conf /etc/nginx/nginx.conf
COPY supervisord.conf /etc/supervisor/supervisord.conf
COPY www/index.php /workspace/public/index.php

# every path the runtime user writes to must be owned by uid 1000 (or live under /tmp)
RUN mkdir -p /workspace/public /tmp/nginx /home/dev/.composer/vendor/bin /var/log/nginx /var/lib/nginx \
 && chown -R 1000:1000 /workspace /home/dev /var/log/nginx /var/lib/nginx /tmp/nginx \
 && chmod 0644 /etc/nginx/nginx.conf /etc/supervisor/supervisord.conf

EXPOSE 80
USER dev
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/pc-entrypoint.sh"]
CMD ["supervisord", "-n", "-c", "/etc/supervisor/supervisord.conf"]
